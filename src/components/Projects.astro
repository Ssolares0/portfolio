---

<section id="work" class="section-work">
  <div class="section-header">
    <h2 class="section-title">Selected Work</h2>
    <p class="section-subtitle">Production applications solving real problems</p>
  </div>

  <div class="projects-list">
    {projects.map((project) => (
      <article class="project-item" data-index={project.index}>
        <div class="project-visual">
          <div class="project-thumbnail">
            <img
              src={project.image}
              alt={project.imageAlt}
              class="project-image lazy-image"
              loading="lazy"
              decoding="async"
              width="640"
              height="400"
            />
          </div>
        </div>
        <div class="project-content">
          <div class="project-meta">
            <span class="project-year">{project.year}</span>
            <span class="project-type">{project.type}</span>
          </div>
          <h3 class="project-name">{project.name}</h3>
          <p class="project-description">{project.description}</p>
          
          {project.stats && (
            <div class="project-stats">
              {project.stats.map((stat) => (
                <div class="stat-item">
                  <span class="stat-value">{stat.value}</span>
                  <span class="stat-label">{stat.label}</span>
                </div>
              ))}
            </div>
          )}
          
          {project.tech && (
            <div class="project-tech">
              {project.tech.map((tech) => (
                <span class="tech-badge">{tech}</span>
              ))}
            </div>
          )}
          
          <div class="project-links">
            {project.links.map((link) => (
              <a href={link.url} class="project-link" target="_blank" rel="noopener">
                <span>{link.label}</span>
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
                  <path d="M6 3H3v10h10v-3M11 3h5v5M8 8l8-8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
              </a>
            ))}
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<script>
  const lazyImages = document.querySelectorAll('.lazy-image');
  
  if ('IntersectionObserver' in window) {
    const imageObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const img = entry.target as HTMLImageElement;
          const thumbnail = img.closest('.project-thumbnail');
          
          img.addEventListener('load', () => {
            img.classList.add('loaded');
            if (thumbnail) {
              thumbnail.classList.add('loaded');
            }
          });
          
          if (img.complete) {
            img.classList.add('loaded');
            if (thumbnail) {
              thumbnail.classList.add('loaded');
            }
          }
          
          observer.unobserve(img);
        }
      });
    }, {
      rootMargin: '50px 0px',
      threshold: 0.01
    });
    
    lazyImages.forEach(img => imageObserver.observe(img));
  } else {
    lazyImages.forEach(img => {
      img.classList.add('loaded');
      const thumbnail = img.closest('.project-thumbnail');
      if (thumbnail) {
        thumbnail.classList.add('loaded');
      }
    });
  }
</script>
